# Copy to .env and adjust. Real environment variables override this file.
PORT=8080
MONGO_URI=mongodb://localhost:27017
MONGO_DB=peoplepulse
# At least 32 random characters.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
INVITE_TTL=72h
PASSWORD_RESET_TTL=1h
# Set to false only for local development over http://localhost.
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000
# Address of the web app, used for links in notification emails.
APP_BASE_URL=http://localhost:3000
# n8n webhook that receives events. Leave empty to turn email delivery off;
# in-app notifications work either way. The secret signs each request (32+ characters).
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
